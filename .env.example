# Build-time overrides only (static export: every value ends up in public HTML/JS — never put a secret here).
# Defaults confirmed by the owner live in src/shared/config/site.ts; set a value here only to override it.
# Copy to .env.local.

# Public URL of the site, no trailing slash (canonical URLs, sitemap, share previews).
NEXT_PUBLIC_SITE_URL=

# Search indexing: "true" only for the approved production build.
SITE_INDEXABLE=

# Public postcard-registration Tally form ID (the code in https://tally.so/r/<ID>).
# Must be the SHORT form (first name, email, country, optional updates) — never the shipping-address form.
NEXT_PUBLIC_TALLY_FORM_ID=

# Social / contact (full URLs / email; leave empty to use the defaults).
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

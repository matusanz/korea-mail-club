# Build-time settings only (static export: every value below ends up in public HTML/JS,
# so never put a secret here — the MailerLite API key is NOT needed and must never be added).
# Copy to .env.local and fill in. Empty values hide the related link/feature instead of
# showing a placeholder.

# Public URL of the site, no trailing slash (canonical URLs, sitemap, share previews).
NEXT_PUBLIC_SITE_URL=

# Search indexing: "true" only for the approved production build.
SITE_INDEXABLE=

# MailerLite embedded form (Forms → Embedded forms → your form → "HTML code" tab).
# In the form action URL https://assets.mailerlite.com/jsonp/<ACCOUNT_ID>/forms/<FORM_ID>/subscribe
NEXT_PUBLIC_MAILERLITE_ACCOUNT_ID=
NEXT_PUBLIC_MAILERLITE_FORM_ID=

# Social / contact (full URLs; leave empty to hide).
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
